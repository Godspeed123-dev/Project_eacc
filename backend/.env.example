# Copy this file to .env and adjust as needed.

PORT=3000

# CoinGecko coin ID used for the live price/market-cap/volume widget.
# Find it in the URL of your token's CoinGecko page,
# e.g. coingecko.com/en/coins/<this-part>
COINGECKO_COIN_ID=effective-accelerationism

# Optional: CoinGecko API key. Leave blank to call the public endpoint
# unauthenticated (fine for low traffic, but rate-limited).
COINGECKO_API_KEY=

# Set to "demo" for a free-tier Demo key (still calls api.coingecko.com),
# or "pro" for a paid Pro key (calls pro-api.coingecko.com). Ignored if
# COINGECKO_API_KEY is blank.
COINGECKO_API_KEY_TYPE=demo
